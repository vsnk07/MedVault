<%- include('../partials/head', { title: 'My Profile' }) %>
<%- include('../partials/header') %>
<main class="content">

  <h1 class="section-title mb">My Health Profile</h1>

  <% if (message) { %><div class="alert alert-success"><%= message %></div><% } %>

  <div class="emergency-grid">
    <div class="card qr-card">
      <h3>📱 My Emergency QR Code</h3>
      <p class="text-muted">Print this or keep it in your wallet. Hospital staff scan it for instant access to your critical health information.</p>
      <div class="qr-wrap">
        <img class="qr" src="<%= qrSrc %>" alt="Emergency QR Code">
      </div>
      <a class="btn btn-outline btn-block mt" href="/emergency/<%= patient.aadhaar %>" target="_blank">Preview Emergency Page →</a>
    </div>

    <div class="card">
      <h3>Personal Details</h3>
      <form method="POST" action="/patient/profile">
      <div class="form-grid">
        <div class="form-group">
          <label>Full Name</label>
          <input value="<%= patient.name %>" disabled>
        </div>
        <div class="form-group">
          <label>Aadhaar Number</label>
          <input value="<%= patient.aadhaar %>" disabled>
        </div>
        <div class="form-group">
          <label>Date of Birth</label>
          <input value="<%= patient.dob || '' %>" disabled>
        </div>
        <div class="form-group">
          <label>Gender</label>
          <input value="<%= patient.gender || '' %>" disabled>
        </div>
        <div class="form-group">
          <label>Phone</label>
          <input name="phone" value="<%= patient.phone || '' %>" maxlength="10">
        </div>
        <div class="form-group">
          <label>Blood Group</label>
          <select name="blood_group">
            <option value="">Select</option>
            <% ['O+','O-','A+','A-','B+','B-','AB+','AB-'].forEach(function(b){ %>
              <option <%= patient.blood_group === b ? 'selected' : '' %>><%= b %></option>
            <% }); %>
          </select>
        </div>
      </div>
      <div class="form-group">
        <label>Address</label>
        <textarea name="address" rows="2"><%= patient.address || '' %></textarea>
      </div>
      <div class="form-grid">
        <div class="form-group">
          <label>Allergies *</label>
          <input name="allergies" value="<%= patient.allergies || '' %>" placeholder="e.g. Penicillin, Dust, Nuts...">
        </div>
        <div class="form-group">
          <label>Emergency Contact Name</label>
          <input name="emergency_contact" value="<%= patient.emergency_contact || '' %>">
        </div>
        <div class="form-group">
          <label>Emergency Contact Phone</label>
          <input name="emergency_phone" value="<%= patient.emergency_phone || '' %>" maxlength="10">
        </div>
      </div>
      <button class="btn btn-primary" type="submit">Save Changes</button>
    </form>
    </div>
  </div>

</main>
<%- include('../partials/footer') %>
</body>
</html>
