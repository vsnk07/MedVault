<%- include('../partials/head', { title: 'Audit Log' }) %>
<%- include('../partials/header') %>
<main class="content">

  <h1 class="section-title mb">Government Audit Trail</h1>
  <p class="text-muted mb">Every access to patient records and every upload is logged here for accountability and transparency.</p>

  <div class="card">
    <% if (logs.length === 0) { %>
      <p class="text-muted">No activity logged yet.</p>
    <% } else { %>
    <div class="table-wrap">
      <table class="data">
        <tr><th>Time</th><th>Actor</th><th>Role</th><th>Action</th><th>Details</th></tr>
        <% logs.forEach(function(l){ %>
        <tr>
          <td><%= l.created_at %></td>
          <td><%= l.actor_name || 'System' %></td>
          <td><%= l.actor_role || 'system' %></td>
          <td><span class="badge-pill type"><%= l.action %></span></td>
          <td><%= l.details %></td>
        </tr>
        <% }); %>
      </table>
    </div>
    <% } %>
  </div>

</main>
<%- include('../partials/footer') %>
</body>
</html>
