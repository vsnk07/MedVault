<%- include('../partials/head', { title: 'Admin Overview' }) %>
<%- include('../partials/header') %>
<main class="content">

  <h1 class="section-title mb">Government Health Authority — Overview</h1>

  <div class="stats-row">
    <div class="stat-card"><div class="num"><%= stats.patients %></div><div class="lbl">Citizens Registered</div></div>
    <div class="stat-card"><div class="num"><%= stats.hospitals %></div><div class="lbl">Verified Hospitals</div></div>
    <div class="stat-card"><div class="num"><%= stats.records %></div><div class="lbl">Medical Records</div></div>
    <div class="stat-card"><div class="num"><%= stats.pending %></div><div class="lbl">Pending Approvals</div></div>
  </div>

  <div class="card">
    <h3>Recent Activity Across the Nation</h3>
    <% if (recent.length === 0) { %>
      <p class="text-muted">No recent activity.</p>
    <% } else { %>
    <div class="table-wrap">
      <table class="data">
        <tr><th>Time</th><th>Patient</th><th>Aadhaar</th><th>Hospital</th><th>Report</th></tr>
        <% recent.forEach(function(r){ %>
        <tr>
          <td><%= r.uploaded_at %></td>
          <td><strong><%= r.patient_name %></strong></td>
          <td><%= r.aadhaar %></td>
          <td><%= r.hospital_name || '—' %></td>
          <td><%= r.title %></td>
        </tr>
        <% }); %>
      </table>
    </div>
    <% } %>
    <a class="btn btn-outline mt" href="/admin/audit">View Full Audit Trail →</a>
  </div>

</main>
<%- include('../partials/footer') %>
</body>
</html>
