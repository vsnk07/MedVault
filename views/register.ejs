<%- include('partials/head', { title: 'Register' }) %>
<%- include('partials/header') %>
<main class="content">

  <h1 class="section-title center">New Citizen Registration</h1>
  <p class="text-muted center mb">Register with your Aadhaar to create your unified health profile.</p>

  <% if (error) { %><div class="alert alert-error center"><%= error %></div><% } %>
  <% if (success) { %><div class="alert alert-success center"><%= success %></div><% } %>

  <div class="card" style="max-width:620px; margin:0 auto;">
    <form method="POST" action="/register">
      <div class="form-grid">
        <div class="form-group">
          <label>Full Name *</label>
          <input name="name" required>
        </div>
        <div class="form-group">
          <label>Aadhaar Number *</label>
          <input name="aadhaar" required maxlength="12" pattern="\d{12}" placeholder="12-digit number">
        </div>
        <div class="form-group">
          <label>Date of Birth</label>
          <input type="date" name="dob">
        </div>
        <div class="form-group">
          <label>Gender</label>
          <select name="gender">
            <option value="">Select</option>
            <option>Male</option><option>Female</option><option>Other</option>
          </select>
        </div>
        <div class="form-group">
          <label>Blood Group</label>
          <select name="blood_group">
            <option value="">Select</option>
            <option>O+</option><option>O-</option><option>A+</option><option>A-</option>
            <option>B+</option><option>B-</option><option>AB+</option><option>AB-</option>
          </select>
        </div>
        <div class="form-group">
          <label>Phone</label>
          <input name="phone" maxlength="10">
        </div>
      </div>
      <div class="form-group">
        <label>Address</label>
        <textarea name="address" rows="2"></textarea>
      </div>
      <div class="form-grid">
        <div class="form-group">
          <label>Create Password *</label>
          <input type="password" name="password" required>
        </div>
        <div class="form-group">
          <label>Confirm Password *</label>
          <input type="password" name="confirm" required>
        </div>
      </div>
      <button class="btn btn-green btn-block" type="submit">Register</button>
    </form>
    <p class="text-muted mt center">Already registered? <a href="/login?role=patient">Sign in</a></p>
  </div>

</main>
<%- include('partials/footer') %>
</body>
</html>
